{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client"]
  },
  "include": ["src"],
  // *.test.ts run under `bun test` (its own transpiler, no type-check), not
  // this project's `vite`/`tsc` build -- `bun:test`'s ambient types come from
  // `bun-types`, which is not a dependency of this package (the app itself
  // never imports it), and this slice's hard rule is no new dependencies.
  // Excluding them here keeps `tsc -p app/ui/v2` -- the actual SHIPPED code --
  // clean without adding one.
  "exclude": ["src/**/*.test.ts"]
}
