{
  "name": "arra-v4-server",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "cli": "bun run ../cli.ts",
    "test": "bun test.order.ts && bun test --bail $(cat test.order.txt) ../cli*.test.ts",
    "typecheck": "tsc --project tsconfig.json",
    "build": "bun build src/index.ts --target=bun --packages=external --outdir .tmp/build",
    "test:order": "bun test.order.ts",
    "test:full": "bun test test ../cli*.test.ts",
    "test:fast": "bun test.order.ts && bun test --bail $(cat test.fast.txt) ../cli*.test.ts",
    "test:census": "./test-census.sh",
    "test:association": "bun test test/association-*.test.ts",
    "test:auth": "bun test test/auth-*.test.ts",
    "test:batch-worker": "bun test test/batch-worker.test.ts",
    "test:chat": "bun test test/chat-*.test.ts",
    "test:cli": "bun test ../cli*.test.ts",
    "test:context": "bun test test/context-*.test.ts test/fixtures/context-v1/*.test.ts",
    "test:contract": "bun test test/contract-*.test.ts",
    "test:evidence": "bun test test/evidence-*.test.ts",
    "test:fts": "bun test test/fts-*.test.ts",
    "test:jcs": "bun test test/jcs-*.test.ts",
    "test:knowledge-chat": "bun test test/knowledge-chat-*.test.ts",
    "test:lifecycle": "bun test test/lifecycle-*.test.ts",
    "test:mcp": "bun test test/mcp-*.test.ts",
    "test:migration": "bun test test/migration-*.test.ts",
    "test:publication": "bun test test/publication-*.test.ts test/fixtures/publication-v1/*.test.ts",
    "test:read-cursor": "bun test test/read-cursor-*.test.ts",
    "test:relic": "bun test test/relic-*.test.ts",
    "test:replay": "bun test test/replay-*.test.ts",
    "test:revision": "bun test test/revision-*.test.ts",
    "test:search-chunk": "bun test test/search-chunk-*.test.ts",
    "test:session-link": "bun test test/session-link-*.test.ts",
    "test:source-ingestion": "bun test test/source-ingestion-*.test.ts",
    "test:target-schema": "bun test test/target-schema-*.test.ts",
    "test:taxonomy": "bun test test/taxonomy-*.test.ts",
    "test:trace": "bun test test/trace-*.test.ts",
    "test:transport": "bun test test/transport-*.test.ts",
    "test:ui-scope": "bun test test/ui-scope.test.ts",
    "test:workspace-isolation": "bun test test/workspace-isolation*.test.ts",
    "test:parallel": "bun test.parallel.ts"
  },
  "dependencies": {
    "@elysiajs/static": "^1.4.10",
    "@lancedb/lancedb": "0.38.0",
    "elysia": "^1.4.30",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
